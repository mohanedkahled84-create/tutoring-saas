{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-app.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-platform.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-platform.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-app.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-gules-xi-53.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-platform-mohaned-khaled1.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-platform-mohaned-khaled1.vercel.app"
        }
      ],
      "destination": "https://centerly-eg.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/apps/web/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|ico|jpg|jpeg|svg|webp|woff2|woff|ttf|webmanifest))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://*.railway.app; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/src/:path*",
      "destination": "/apps/web/src/:path*"
    },
    {
      "source": "/portal",
      "destination": "/index.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/p/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/s/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|apps/).*)",
      "destination": "/index.html"
    }
  ]
}