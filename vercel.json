{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-app.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-eg.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-platform.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-eg.com/$1"
      }
    }
  ]
}