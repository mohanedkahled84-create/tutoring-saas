{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "centerly-platform.vercel.app"
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(src|favicon.png)(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none';" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-platform.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-mohaned-khaled1.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-gules-xi-53.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-platform-mohaned-khaled1.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centerly-platform-mohaned-khaled1.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-app.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}