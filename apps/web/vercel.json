{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "centerly-platform.vercel.app"
  ],
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly-platform.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "centrly.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-mohaned-khaled1.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "web-gules-xi-53.vercel.app"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://centerly-platform.vercel.app/$1"
      }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}