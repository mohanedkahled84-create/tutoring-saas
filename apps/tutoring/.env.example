# Sentry Error Monitoring & Tracing
# Optional server-only teacher domain provisioning. Leave blank to keep manual provisioning.
# Use an operator-managed Vercel credential authorized for the designated project/team.
# Provisioning is retried when platform settings are read or saved; existing verified links are reused.
PORTAL_VERCEL_TOKEN=
PORTAL_VERCEL_PROJECT_ID=
PORTAL_VERCEL_TEAM_ID=

SENTRY_DSN=https://your-sentry-key@o123456.ingest.sentry.io/1234567
